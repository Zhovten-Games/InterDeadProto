# Copy this file to tests/local-build-lab/config.env to override defaults.

# Optional custom output directory (absolute path or relative to proto-dev root)
# LOCAL_BUILD_OUTPUT_DIR="/absolute/path/to/output"

# Optional custom isolated workspace used by the local pipeline runner
# LOCAL_BUILD_WORKSPACE_DIR="/absolute/path/to/workspace"

# Optional preview port used with --serve
# LOCAL_BUILD_PORT="4173"

# Optional build id used by VITE cache logic
# VITE_CACHE_BUILD_ID="local-manual-build-id"

# Optional root directory for local package discovery
# LOCAL_PACKAGES_ROOT="../../InterDeadCore"

# Optional prepared package workspace path
# LOCAL_PACKAGES_WORKSPACE_DIR="tests/local-build-lab/packages-workspace"

# Optional comma-separated package selection
# LOCAL_PACKAGES="all"

# Optional package map overrides (comma-separated)
# LOCAL_PACKAGE_MAP="@interdead/framework=../../../InterDeadCore/framework"

# CLI flags always have priority over config.env values
