# Copy this file to proto-dev/tests/local-build-lab/config.env to override defaults.

# Optional custom output directory (absolute path or relative to InterDeadProto root)
# LOCAL_BUILD_OUTPUT_DIR="/absolute/path/to/output"

# Optional custom isolated workspace used by the local pipeline runner
# LOCAL_BUILD_WORKSPACE_DIR="/absolute/path/to/workspace"

# Optional preview port used with --serve
# LOCAL_BUILD_PORT="4173"

# Optional build id used by VITE cache logic
# VITE_CACHE_BUILD_ID="local-manual-build-id"
