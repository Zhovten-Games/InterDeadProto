{
  "name": "interdead-proto",
  "version": "0.1.0",
  "private": true,
  "description": "Build and formatting pipeline for InterDeadProto proto-dev app.",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "build:deploy": "vite build --config vite.deploy.config.js",
    "format": "node ../build/format.mjs --write",
    "format:check": "node ../build/format.mjs",
    "local:pipeline": "node ../build/local-lab.mjs",
    "local:pipeline:serve": "node ../build/local-lab.mjs --serve",
    "local:pipeline:smoke": "node ../build/local-lab.mjs --smoke",
    "test": "node ./tools/run-tests.mjs",
    "lint": "node ../build/lint.mjs",
    "audit:dependencies": "node ../build/audit.mjs",
    "check": "node ../constitutional-guard/run.mjs all",
    "assemble": "node ../build/assemble.mjs",
    "codemap:check": "node ../build/check-source.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "espree": "10.4.0",
    "fflate": "0.8.3",
    "globals": "14.0.0",
    "js-yaml": "4.3.2",
    "jsdom": "28.1.0",
    "mocha": "12.0.3",
    "playwright": "1.58.2",
    "prettier": "3.8.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sql.js": "1.14.2",
    "unified": "11.0.5",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@interdead/framework": "0.1.1"
  },
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0"
}
