{
  "name": "interdead-proto",
  "version": "0.1.0",
  "private": true,
  "description": "Build and formatting pipeline for InterDeadProto proto-dev app.",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "build:deploy": "vite build --config vite.deploy.config.js",
    "format": "prettier --write \"src/**/*.{js,json}\" \"tests/**/*.js\" \"index.html\" \"*.{md,js,json}\" \"../.github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{js,json}\" \"tests/**/*.js\" \"index.html\" \"*.{md,js,json}\" \"../.github/workflows/*.yml\"",
    "local:pipeline": "bash ./tests/local-build-lab/run-local-pipeline.sh",
    "local:pipeline:serve": "bash ./tests/local-build-lab/run-local-pipeline.sh --serve",
    "local:pipeline:smoke": "bash ./tests/local-build-lab/run-local-pipeline.sh --smoke"
  },
  "devDependencies": {
    "jsdom": "^28.1.0",
    "mocha": "^11.7.5",
    "prettier": "^3.3.0",
    "vite": "^5.4.11"
  }
}
