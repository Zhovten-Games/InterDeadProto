{
  "$schema": "./build/schemas/codemap-manifest.schema.json",
  "schemaVersion": "2.0.0",
  "project": {
    "name": "interdead-proto",
    "defaultBranch": "main"
  },
  "validation": {
    "profiles": {
      "default": {
        "bundleName": "proto-default",
        "families": {
          "architecture": {
            "enabled": true,
            "failOn": ["error", "critical"],
            "thresholds": {
              "error": 0
            }
          },
          "documentation-contract": {
            "enabled": true,
            "failOn": ["error", "critical"],
            "thresholds": {
              "error": 0
            }
          },
          "methodology-semantic": {
            "enabled": true,
            "failOn": ["error", "critical"],
            "thresholds": {
              "error": 0
            },
            "mechanism": "Objective topology/name checks plus manual.normative-semantic-review; no external semantic certification is asserted"
          }
        },
        "mode": "enforced",
        "documentation": {
          "mode": "enforced",
          "requiredHeaders": [
            "source",
            "source_exists",
            "imports",
            "implements",
            "owns",
            "listens",
            "emits",
            "used_by",
            "runtime_role",
            "contour_primary",
            "role_group"
          ],
          "pathScopes": [
            {
              "include": "docs/proto-dev/src/**/*.md",
              "mode": "enforced"
            },
            {
              "include": "docs/proto-dev/technical/**/*.md",
              "mode": "informational"
            },
            {
              "include": "proto-dev/docs/**/*.md",
              "mode": "informational"
            }
          ],
          "projectModes": {
            "interdead-proto": "enforced"
          }
        }
      }
    }
  },
  "scan": {
    "include": [
      "proto-dev/src/**/*.js",
      "proto-dev/tests/**/*.js",
      "docs/proto-dev/**/*.md",
      "proto-dev/docs/**/*.md"
    ],
    "exclude": ["**/node_modules/**", "**/dist/**"],
    "followSymlinks": false,
    "parser": {
      "javascript": true,
      "typescript": false,
      "markdown": true
    }
  },
  "methodology": {
    "visual": {
      "id": "hexagonal",
      "version": "1.0.0"
    },
    "semantic": {
      "id": "capability-boundaries",
      "version": "1.0.0"
    }
  },
  "documentation": {
    "sources": [
      {
        "id": "proto-docs",
        "type": "markdown-headers",
        "include": ["docs/proto-dev/src/**/*.md"],
        "mode": "full"
      }
    ]
  },
  "publish": {
    "mode": "artifacts-only",
    "readme": {
      "enabled": false
    },
    "preview": {
      "enabled": false
    }
  },
  "output": {
    "rootDir": "build/results",
    "artifacts": [
      {
        "id": "source-codemap-report",
        "kind": "json",
        "enabled": true,
        "path": "source-check.json",
        "publicSafe": false
      }
    ]
  },
  "runner": {
    "command": "node build/check-source.mjs",
    "scope": "source syntax/import graph, declared boundaries, complete source/docs/locale/template mappings",
    "limits": "Does not certify runtime races or substitute human semantic review",
    "schemaCompatibility": "Project-local manifest 2.0.0 / markdown-headers 1; exact semantic responsibility review is manual; external CodeMap certification is not asserted"
  }
}
