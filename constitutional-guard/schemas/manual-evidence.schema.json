{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "results"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "reviewer",
          "date",
          "sourceSha",
          "artifactTreeSha256",
          "zipSha256",
          "buildId",
          "browser",
          "os",
          "origins",
          "result",
          "references"
        ],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "reviewer": { "type": "string", "minLength": 2 },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
          },
          "sourceSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "artifactTreeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "zipSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "buildId": { "type": "string", "minLength": 1 },
          "browser": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          },
          "os": { "type": "string", "minLength": 1 },
          "origins": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^https?://" }
          },
          "result": {
            "enum": ["passed", "failed", "unavailable", "pending", "manual evidence required"]
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
